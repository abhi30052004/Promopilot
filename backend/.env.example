# PromoPilot Backend – Environment Variables Example
# Copy to .env and fill in real values. Never commit .env.

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_MODEL=gpt-image-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_VECTOR_INDEXING=false

# ─── Groq ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# ─── Chroma ──────────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_data

# ─── Media / Storage ─────────────────────────────────────────────────────────
# For local dev:
STORAGE_BACKEND=local
MEDIA_DIR=./media
MEDIA_BASE_URL=http://localhost:8000/media

# For production (Render + S3-compatible storage), replace the local setting above:
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_PREFIX=promopilot

# Alternative production storage (MongoDB GridFS):
# STORAGE_BACKEND=mongo
MONGODB_URI=
MONGODB_DB=promopilot_media
PUBLIC_API_BASE_URL=http://localhost:8000
MEDIA_MAX_TOTAL_MB=400

MAX_AI_IMAGES_PER_PROPERTY=3

# ─── Telegram (optional live publisher) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Auth ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=your-very-long-random-string

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
TIMEZONE=Asia/Jerusalem
FRONTEND_URL=https://promopilot-cyan.vercel.app

# ─── Scheduler tick (for external cron on Render free tier) ──────────────────
SCHEDULER_TOKEN=random-secret-token

# ─── End-to-end spec additions ───────────────────────────────────────────────
MONGODB_DATABASE=promopilot_media
DEFAULT_CONTACT_EMAIL=contact@tzelahahar.co.il
DEFAULT_LANGUAGE=en
DEFAULT_APPROVAL_MODE=human
DEFAULT_PLATFORMS=instagram,facebook,linkedin
# Max scraped items auto-processed per scrape run in AUTOMATION mode (cost safeguard)
AUTOMATION_BATCH_LIMIT=3
